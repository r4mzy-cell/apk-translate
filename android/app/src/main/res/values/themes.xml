<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TranslateId</item>
    </style>

    <style name="Theme.TranslateId" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary_teal</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/primary_dark</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorSurfaceVariant">@color/surface_container</item>
        <item name="colorOnSurfaceVariant">@android:color/white</item>
        <item name="colorOutline">@color/divider_color</item>
        <item name="colorOutlineVariant">@color/divider_color</item>
        <item name="colorError">@color/status_error</item>
    </style>

    <style name="NormalTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/windowLightStatusBar</item>
        <item name="android:windowLightNavigationBar">?attr/windowLightNavigationBar</item>
    </style>

    <!-- Colors used in themes but not defined elsewhere -->
    <color name="splash_background">#1A1A2E</color>
    <color name="divider_color">#2A3550</color>
</resources>