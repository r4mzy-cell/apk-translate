<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Main bubble button -->
    <ImageView
        android:id="@+id/bubble_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_background"
        android:src="@drawable/ic_translate"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:contentDescription="@string/bubble_desc" />

    <!-- Expandable menu -->
    <LinearLayout
        android:id="@+id/bubble_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="72dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:background="@drawable/menu_background"
        android:padding="8dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/menu_live_translate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_live_translate"
            android:padding="12dp"
            android:contentDescription="@string/menu_live_translate"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/menu_screenshot"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_screenshot"
            android:padding="12dp"
            android:contentDescription="@string/menu_screenshot"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/menu_audio_translate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_audio_translate"
            android:padding="12dp"
            android:contentDescription="@string/menu_audio_translate"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/menu_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_settings"
            android:padding="12dp"
            android:contentDescription="@string/menu_settings"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <ImageView
            android:id="@+id/menu_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:padding="12dp"
            android:contentDescription="@string/menu_close"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

</FrameLayout>